{
  "name": "beautyshop",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "npm run test --workspace=@beautyshop/api",
    "test:watch": "npm run test:watch --workspace=@beautyshop/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=@beautyshop/api",
    "db:generate": "npm run db:generate --workspace=@beautyshop/api",
    "test:unit": "npm test --workspace=@beautyshop/api -- --exclude '**/*.integration.spec.ts'",
    "test:integration": "npm run test:integration --workspace=@beautyshop/api",
    "test:web": "npm test --workspace=@beautyshop/web",
    "test:e2e": "npm exec --workspace=@beautyshop/web -- playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "jsdom": "22.1.0",
    "prettier": "3.9.8"
  }
}

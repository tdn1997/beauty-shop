{
  "name": "beautyshop",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "npm run test --workspace=@beautyshop/api",
    "test:watch": "npm run test:watch --workspace=@beautyshop/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=@beautyshop/api",
    "db:generate": "npm run db:generate --workspace=@beautyshop/api"
  }
}

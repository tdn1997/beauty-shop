// Lược đồ lưu trữ. Đây là tầng đóng gói thứ hai: domain giữ bất biến trong bộ nhớ,
// còn CHECK / UNIQUE dưới đây giữ chúng kể cả khi có ai đó ghi thẳng vào DB.
// Các ràng buộc CHECK nằm trong migration SQL — Prisma schema không khai báo được.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  DISPATCHED
  CANCELLED

  @@map("order_status")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("outbox_status")
}

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  ACTIVE
  DISCONTINUED

  @@map("variant_status")
}

model OutboxEvent {
  id          String       @id @map("id")
  eventType   String       @map("event_type")
  aggregateId String       @map("aggregate_id")
  payload     Json         @map("payload")
  status      OutboxStatus @default(PENDING) @map("status")
  attempts    Int          @default(0) @map("attempts")
  lastError   String?      @map("last_error")
  occurredAt  DateTime     @map("occurred_at")
  /// Optimistic lock: mọi lần ghi đều kèm `WHERE version = <phiên bản đã đọc>`.
  version     Int          @default(0) @map("version")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, occurredAt])
  @@map("outbox_event")
}

model SalesOrder {
  id                 String      @id
  customerId         String      @map("customer_id")
  currency           String      @db.Char(3)
  status             OrderStatus
  /// Optimistic lock: mọi lần ghi đều kèm `WHERE version = <phiên bản đã đọc>`.
  version            Int         @default(0)
  cancellationReason String?     @map("cancellation_reason")
  discount           BigInt      @default(0)
  shippingFee        BigInt      @default(0) @map("shipping_fee")

  // Địa chỉ giao là **bản chụp** tại thời điểm đặt, không phải khoá ngoại sang
  // sổ địa chỉ của khách: khách sửa địa chỉ sau này không được làm đổi đơn cũ.
  shipRecipientName String? @map("ship_recipient_name")
  shipPhone         String? @map("ship_phone")
  shipLine1         String? @map("ship_line1")
  shipLine2         String? @map("ship_line2")
  shipWard          String? @map("ship_ward")
  shipDistrict      String? @map("ship_district")
  shipProvince      String? @map("ship_province")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines OrderLine[]

  @@index([customerId])
  @@map("sales_order")
}

model OrderLine {
  id           String @id
  orderId      String @map("order_id")
  variantId    String @map("variant_id")
  sku          String
  /// Bản chụp tên và giá lúc đặt — không tham chiếu catalog.
  nameSnapshot String @map("name_snapshot")
  /// Tiền lưu bằng đơn vị nhỏ nhất (BigInt), không bao giờ là số thực.
  unitPrice    BigInt @map("unit_price")
  quantity     Int

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Một biến thể chỉ được xuất hiện một dòng trong đơn — gộp lượng, không nhân dòng.
  @@unique([orderId, variantId])
  @@map("order_line")
}

model InventoryLot {
  id          String    @id
  variantId   String    @map("variant_id")
  lotCode     String    @map("lot_code")
  onHand      Int       @map("on_hand")
  /// Phần đã giữ chỗ. Bất biến `0 <= reserved <= on_hand` do CHECK ở migration giữ.
  reserved    Int       @default(0)
  expiresOn   DateTime? @map("expires_on") @db.Date
  blocked     Boolean   @default(false)
  blockReason String?   @map("block_reason")
  version     Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variantId, lotCode])
  @@index([variantId])
  @@map("inventory_lot")
}

model CheckoutReplay {
  customerId  String            @map("customer_id")
  key         String
  requestHash String            @map("request_hash")
  status      IdempotencyStatus
  response    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@id([customerId, key])
  @@map("checkout_replay")
}

model Product {
  id           String        @id
  name         String
  description  String        @default("")
  category     String        @default("other")
  imagePath    String?       @map("image_path")
  imageAlt     String?       @map("image_alt")
  displayOrder Int           @default(0) @map("display_order")
  status    ProductStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("product")
}

model ProductVariant {
  id        String        @id
  productId String        @map("product_id")
  sku       String        @unique
  name        String
  displayName String @default("") @map("display_name")
  /// Tiền lưu bằng đơn vị nhỏ nhất (BigInt), không bao giờ là số thực.
  listPrice BigInt        @map("list_price")
  currency  String        @db.Char(3)
  status    VariantStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variant")
}

model User {
  id           String   @id
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  role         UserRole @default(CUSTOMER)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  addresses CustomerAddress[]

  @@map("app_user")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("session")
}

model CustomerAddress {
  id            String   @id
  customerId    String   @map("customer_id")
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  ward          String
  district      String
  province      String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_address")
}

model IdempotencyRecord {
  customerId  String            @map("customer_id")
  key         String
  requestHash String            @map("request_hash")
  status      IdempotencyStatus
  response    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  // Khoá chính ghép chính là cơ chế nguyên tử của `reserve()`: hai request song
  // song cùng khoá thì một cái phải vấp lỗi trùng khoá, không cái nào đọc-rồi-ghi.
  @@id([customerId, key])
  @@map("idempotency_record")
}

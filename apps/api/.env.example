# Postgres cục bộ dựng bằng `npm run db:up` (docker-compose, cổng 5433).
DATABASE_URL="postgresql://beautyshop:beautyshop@localhost:5433/beautyshop?schema=public"

# Explicit demo-only seed gate. Never enable in production.
BEAUTYSHOP_DEMO_SEED=true
SEED_ADMIN_PASSWORD=123
SEED_CUSTOMER_PASSWORD=123
SEED_CUSTOMER2_PASSWORD=123
# Browser-visible Next origin used for exact Origin validation.
WEB_ORIGIN=http://localhost:3000
